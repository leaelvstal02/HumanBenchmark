<Window x:Class="HumanBenchmark.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HumanBenchmark"
        xmlns:vm="clr-namespace:HumanBenchmark.ViewModels.Shell"
        xmlns:sequence ="clr-namespace:HumanBenchmark.Views.Sequence"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainShellViewModel}"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
       
        <ContentControl Grid.Row="1" Content="{Binding CurrentGame.Screen}"/>
    </Grid>
</Window>
