<Window x:Class="HumanBenchmark.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HumanBenchmark"
        xmlns:vm="clr-namespace:HumanBenchmark.ViewModels.Shell"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainShellViewModel}"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="#FF2B87D1">
        <TextBlock HorizontalAlignment="Left" Margin="25,50,3,0" TextWrapping="Wrap" Text="{Binding Title, FallbackValue=En testrubrik}" VerticalAlignment="Top" FontSize="50" Foreground="GhostWhite" />
        <Button Content="Start" HorizontalAlignment="Left" Margin="250,204,0,0" VerticalAlignment="Top" Height="50" Width="100" Background="#F5C242" BorderBrush="#DAA520" BorderThickness="1" FontWeight="SemiBold" Command="{Binding ChangeTitleCommand}" CommandParameter="Nya rubriken"/>
    </Grid>
</Window>
