<UserControl x:Class="HumanBenchmark.Views.Sequence.SequenceStartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HumanBenchmark.Views.Sequence"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#2F80D1">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock 
            Grid.Row="1"
            HorizontalAlignment="Center"
            FontSize="40"
            FontWeight="SemiBold"
            Foreground="White"
            Text="Sequence Game"/>
        <Button 
            Grid.Row="3"
            Padding="20,10"
            HorizontalAlignment="Center"
            Background="#F5C242"
            BorderBrush="#DAA520"
            Command="{Binding StartCommand}"
            Content="Start"
            FontWeight="SemiBold"
            Foreground="#1D2557"
            Height="50"/>
    </Grid>
</UserControl>
