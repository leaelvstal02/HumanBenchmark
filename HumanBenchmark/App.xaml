<Application x:Class="HumanBenchmark.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HumanBenchmark"
             xmlns:sequenceView="clr-namespace:HumanBenchmark.Views.Sequence"
             xmlns:sequence="clr-namespace:HumanBenchmark.ViewModels.Sequence"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <DataTemplate DataType="{x:Type sequence:SequenceBoardViewModel}">
            <sequenceView:SequenceBoardView/>
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type sequence:SequenceStartViewModel}">
            <sequenceView:SequenceStartView/>
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type sequence:SequenceEndViewModel}">
            <sequenceView:SequenceEndView/>
        </DataTemplate>
    </Application.Resources>
</Application>
